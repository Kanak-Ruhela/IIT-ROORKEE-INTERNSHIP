keyword = "ERROR"
input_file = "server.log"
output_file = "found_lines.txt"
match_count = 0
with open(input_file, "r") as infile, open(output_file, "w") as outfile:
    for line in infile:
        if keyword in line:
            outfile.write(line)
            match_count += 1
print(f"Done! Found {match_count} lines containing '{keyword}'.")
print("Results saved to 'found_lines.txt'.")
